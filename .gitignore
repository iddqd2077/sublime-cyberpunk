# Файлы, которые генерируются автоматически и не нужны в репозитории

# Terminus создаёт скрытые схемы под свой терминал (бывает по 6 МБ)
*.hidden-color-scheme

# Маркеры служебных плагинов
.bootstrap-done
.satisfy-done

# Кэш Python / байткод
__pycache__/
*.pyc

# Сессии и локальный кэш Sublime
*.cache
*.sublime-workspace
*.sublime_session
