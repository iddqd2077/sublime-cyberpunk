{
	"target": "terminus_exec",
	"cancel": "terminus_cancel_build",
	"focus": true,
	"shell_cmd": "python -u \"${file}\"",
	"file_regex": "^  File \"([^\"]+)\", line ([0-9]+)",
	"working_dir": "${file_path}",
	"selector": "source.python",
	"variants":
	[
		{
			"name": "Check Syntax",
			"shell_cmd": "python -m py_compile \"${file}\""
		}
	]
}
