{
	"name": "Cyberpunk 2077",
	"author": "iddqd2077 (palette from endormi/vscode-2077-theme)",
	"variables": {
		"bg": "hsl(220, 84%, 7%)",
		"fg": "#e6f1ff",
		"cyan": "#0ef3ff",
		"blue": "#0098df",
		"brightblue": "#39c0ff",
		"yellow": "#ffd400",
		"pink": "#ff2e97",
		"magenta": "#ff2cf1",
		"purple": "#c832ff",
		"red": "#ec107b",
		"grey": "#7fa8d0"
	},
	"globals": {
		"background": "#030d22",
		"foreground": "#e6f1ff",
		"caret": "#ff2cf1",
		"line_highlight": "#1c1347",
		"selection": "#310072",
		"selection_foreground": "#ffffff",
		"selection_border": "#ff2cf1",
		"inactive_selection": "#1c1347",
		"inactive_selection_foreground": "#c9d8ef",
		"inactive_selection_border": "#35008b",
		"find_highlight": "#003496",
		"find_highlight_foreground": "#ffffff",
		"misspelling": "#ec107b",
		"gutter": "#030d22",
		"gutter_foreground": "#ee0077",
		"gutter_foreground_highlight": "#47a1fa",
		"accent": "#ff2cf1",
		"highlight": "#ff2cf1",
		"highlight_foreground": "#030d22",
		"shadow": "#000000",
		"shadow_width": "2",
		"brackets_options": "underline",
		"brackets_foreground": "#ffd400",
		"bracket_contents_options": "underline",
		"bracket_contents_foreground": "#ffd400",
		"tags_options": "underline",
		"tags_foreground": "#0ef3ff",
		"popup_css": "background: #04112c; border: 1px solid #ff2cf1; color: #e6f1ff;",
		"phantom_css": "background: #04112c; border: 1px solid #ff2cf1; color: #e6f1ff;"
	},
	"rules": [
		{ "name": "Comment", "scope": "comment", "foreground": "#0098df", "font_style": "italic" },
		{ "name": "Comment punctuation", "scope": "punctuation.definition.comment", "foreground": "#0098df", "font_style": "italic" },

		{ "name": "String", "scope": "string", "foreground": "#0ef3ff" },
		{ "name": "String regexp", "scope": "string.regexp", "foreground": "#0ef3ff" },
		{ "name": "String interpolation", "scope": "punctuation.definition.template-expression, punctuation.section.embedded", "foreground": "#ffd400" },

		{ "name": "Number", "scope": "constant.numeric", "foreground": "#ffd400" },
		{ "name": "Built-in constant", "scope": "constant.language", "foreground": "#ff2e97" },
		{ "name": "User-defined constant", "scope": "constant.character, constant.other", "foreground": "#c832ff" },

		{ "name": "Keyword", "scope": "keyword", "foreground": "#ff2cf1" },
		{ "name": "Keyword control", "scope": "keyword.control", "foreground": "#ff2cf1" },
		{ "name": "Keyword operator", "scope": "keyword.operator", "foreground": "#ff2cf1" },
		{ "name": "Keyword other", "scope": "keyword.other", "foreground": "#a83dff" },
		{ "name": "Storage", "scope": "storage", "foreground": "#40a9ff" },
		{ "name": "Storage type", "scope": "storage.type", "foreground": "#ff1bf0" },
		{ "name": "Storage modifier", "scope": "storage.modifier", "foreground": "#ff1bf0" },

		{ "name": "Variable", "scope": "variable", "foreground": "#e6f1ff" },
		{ "name": "Variable language", "scope": "variable.language", "foreground": "#3ec8ff" },
		{ "name": "Variable parameter", "scope": "variable.parameter", "foreground": "#ff2e97" },
		{ "name": "Variable other", "scope": "variable.other", "foreground": "#ff2e97" },
		{ "name": "Variable other object", "scope": "variable.other.object", "foreground": "#40a9ff" },

		{ "name": "Class name", "scope": "entity.name.class, entity.name.type.class, entity.name.type", "foreground": "#ff2e97" },
		{ "name": "Inherited class", "scope": "entity.other.inherited-class", "foreground": "#6ab0ff", "font_style": "italic" },
		{ "name": "Function name", "scope": "entity.name.function", "foreground": "#39c0ff" },
		{ "name": "Function call", "scope": "meta.function-call", "foreground": "#39c0ff" },
		{ "name": "Namespace", "scope": "entity.name.namespace", "foreground": "#0ef3ff" },
		{ "name": "Tag name", "scope": "entity.name.tag", "foreground": "#ff2e97" },
		{ "name": "Tag attribute", "scope": "entity.other.attribute-name", "foreground": "#ffd400" },

		{ "name": "Library function", "scope": "support.function", "foreground": "#ffd400" },
		{ "name": "Library constant", "scope": "support.constant", "foreground": "#39c0ff" },
		{ "name": "Library class/type", "scope": "support.type, support.class", "foreground": "#ff2cf1", "font_style": "italic" },
		{ "name": "Library variable", "scope": "support.other.variable", "foreground": "#39c0ff" },
		{ "name": "Support property name", "scope": "support.type.property-name", "foreground": "#0ef3ff" },

		{ "name": "Punctuation parameters", "scope": "punctuation.definition.parameters", "foreground": "#ffee80" },
		{ "name": "Punctuation separator", "scope": "punctuation.separator, punctuation.terminator", "foreground": "#8ab4f8" },

		{ "name": "Invalid", "scope": "invalid", "foreground": "#9e0a52" },
		{ "name": "Invalid deprecated", "scope": "invalid.deprecated", "foreground": "#00d7e2" },

		{ "name": "Diff header", "scope": "meta.diff, meta.diff.header", "foreground": "#009af3" },
		{ "name": "Diff deleted", "scope": "markup.deleted", "foreground": "#ec107b" },
		{ "name": "Diff inserted", "scope": "markup.inserted", "foreground": "#dbcd00" },
		{ "name": "Diff changed", "scope": "markup.changed", "foreground": "#029fcf" },

		{ "name": "Markdown heading", "scope": "entity.name.section, markup.heading", "foreground": "#ff2e97", "font_style": "bold" },
		{ "name": "Markdown bold", "scope": "markup.bold", "foreground": "#ff2e97", "font_style": "bold" },
		{ "name": "Markdown italic", "scope": "markup.italic", "foreground": "#ff2e97", "font_style": "italic" },
		{ "name": "Markdown link", "scope": "markup.underline.link", "foreground": "#ff22f0" },
		{ "name": "Markdown raw inline", "scope": "markup.raw.inline", "foreground": "#e9e9e9" },
		{ "name": "Markdown raw block", "scope": "markup.raw.block", "foreground": "#ffffff" },

		{ "name": "GitGutter deleted", "scope": "markup.deleted.git_gutter", "foreground": "#e700d8" },
		{ "name": "GitGutter inserted", "scope": "markup.inserted.git_gutter", "foreground": "#ffd400" },
		{ "name": "GitGutter changed", "scope": "markup.changed.git_gutter", "foreground": "#0685fc" }
	]
}
