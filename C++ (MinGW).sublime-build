{
	"target": "terminus_exec",
	"cancel": "terminus_cancel_build",
	"focus": true,
	"shell_cmd": "g++ -std=c++17 -Wall -Wextra -g \"${file}\" -o \"${file_path}\\${file_base_name}.exe\" && \"${file_path}\\${file_base_name}.exe\"",
	"file_regex": "^(..[^:]*):([0-9]+):([0-9]+):? (.*)$",
	"working_dir": "${file_path}",
	"selector": "source.c++",
	"variants":
	[
		{
			"name": "Build Only",
			"shell_cmd": "g++ -std=c++17 -Wall -Wextra -g \"${file}\" -o \"${file_path}\\${file_base_name}.exe\""
		},
		{
			"name": "Run Only",
			"shell_cmd": "\"${file_path}\\${file_base_name}.exe\""
		}
	]
}
